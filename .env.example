# ---> env example: copy to .env.local, never commit real values <---

# Supabase (server + client)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...          # SERVER ONLY. Never NEXT_PUBLIC_*. Never commit.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000        # prod: https://roadmapchurch.crdo.site
NEXT_PUBLIC_APP_NAME="Church Leadership LMS — Command Center"

# Database (Drizzle direct, migrations/seed)
DATABASE_URL=postgresql://postgres:password@db.xyzcompany.supabase.co:5432/postgres

# Auth helpers
SUPABASE_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# GitHub integration stubs (server-only, post-MVP live sync)
GITHUB_TOKEN=
GITHUB_REPO=crdo0923/church_app

# Observability
SENTRY_DSN=                                       # optional until wired
NEXT_PUBLIC_SENTRY_DSN=                           # optional, safe to expose

# Email (post-MVP fan-out; keep empty until provider chosen)
EMAIL_PROVIDER=
EMAIL_API_KEY=                                    # SERVER ONLY
