# ---> env example: copy to .env.local, never commit real values <---

# Tracker database (shared Postgres — local dev default below; prod uses
# a hosted Postgres URL e.g. Supabase/Neon/Vercel Postgres)
DATABASE_URL=postgres://roadmapchurch:roadmapchurch_dev_password@localhost:5433/roadmapchurch

# Super Admin bootstrap (SERVER ONLY — never NEXT_PUBLIC_, never commit the real value)
# Initial setup only; configure the real value in the deployment environment, e.g.:
#   SUPER_ADMIN_BOOTSTRAP_PASSWORD=460111
SUPER_ADMIN_BOOTSTRAP_PASSWORD=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000        # prod: https://roadmapchurch.crdo.site
NEXT_PUBLIC_APP_NAME="Church Leadership LMS — Project Roadmap"
